# Copy this file to .env and fill in your values. All three services below
# are required -- there is no offline/local fallback for the graph or
# memory layers (by design: Neo4j and PostgreSQL only, no SQLite/NetworkX).
# Quickest way to get Neo4j + PostgreSQL running locally:
#   docker-compose up -d

# --- LLM: Groq (https://console.groq.com/keys) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key

GROQ_MODEL=openai/gpt-oss-120b

# --- Knowledge graph: Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Long-term memory: PostgreSQL ---

DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memory_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- RAG embeddings ---
EMBEDDING_BACKEND=tfidf
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K_RETRIEVAL=4
RAG_CONFIDENCE_THRESHOLD=0.08

# --- Memory ---
MAX_SHORT_TERM_TURNS=8
MAX_MEMORY_FACTS_IN_PROMPT=6

# --- Tools ---
WEB_SEARCH_ENABLED=false
